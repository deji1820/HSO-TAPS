PORT=5000
MONGODB_URI=mongodb://hsotap:changeme@localhost:27017/hsotap?authSource=admin
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Shared secret the kiosk device-bridge / kiosk-app uses to hit kiosk-only endpoints
KIOSK_API_KEY=replace_this_too

# Resend transactional email settings for document status notifications.
# Use a sender address on a domain verified in Resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Health Services <notifications@your-verified-domain.edu>

# To send from a personal Gmail account instead, set EMAIL_PROVIDER=gmail
# and use a Google App Password (not your normal account password).
# GMAIL_USER=your.address@gmail.com
# GMAIL_APP_PASSWORD=your_16_character_app_password
