PORT=5000
MONGODB_URI=mongodb://hsotap:changeme@localhost:27017/hsotap?authSource=admin
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Shared secret the kiosk device-bridge / kiosk-app uses to hit kiosk-only endpoints
KIOSK_API_KEY=replace_this_too

# Resend transactional email settings for document status notifications.
# Use a sender address on a domain verified in Resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Health Services <notifications@your-verified-domain.edu>

# Gmail API over HTTPS (works on Render Free). Requires Google OAuth consent
# and a refresh token authorized for https://www.googleapis.com/auth/gmail.send.
# Set EMAIL_PROVIDER=gmail-api and configure all four values below.
# GMAIL_USER=your.address@gmail.com
# GMAIL_CLIENT_ID=your_oauth_client_id
# GMAIL_CLIENT_SECRET=your_oauth_client_secret
# GMAIL_REFRESH_TOKEN=your_oauth_refresh_token

# Legacy Gmail SMTP (requires a host that permits SMTP egress).
# Set EMAIL_PROVIDER=gmail and use a Google App Password.
# GMAIL_APP_PASSWORD=your_16_character_app_password
